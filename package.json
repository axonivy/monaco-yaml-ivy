{
  "name": "@axonivy/monaco-yaml-ivy",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.11"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
